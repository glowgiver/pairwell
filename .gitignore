.DS_Store
*.icloud
__pycache__/

# sources/ holds the original documents the data was transcribed from.
# Never committed: workout_hub.html and hair_protocol.html still contain the
# locating detail scrubbed from this repo in 9bf4883. Kept locally because
# three separate transcriptions turned out to have lost content, and only the
# originals revealed it.
/sources/

# inbox/ is where recipes land before they become data. Not committed: a saved
# recipe page is someone else's copyrighted text, and this repo is public. The
# link and the amounts are what we keep; the page itself stays on the laptop.
/inbox/*
!/inbox/TEMPLATE.md
!/inbox/WHAT-TO-LOOK-FOR.md

# private/ holds body composition and anything exported from MacroFactor.
# The repo is public, not just the site — stripping a field out of the built
# pages does not hide it if the JSON it came from is committed. Anything that
# describes a body rather than a plan belongs here.
/private/
